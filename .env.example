# Copy to .env (never commit .env) and fill in the values from your Neo4j Aura instance.
# Aura shows them once when the instance is created, and in the downloaded credentials file.
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Separate instance for pytest. Every test deletes ALL data in it, so never use the app's instance.
NEO4J_TEST_URI=
NEO4J_TEST_USER=neo4j
NEO4J_TEST_PASSWORD=

SECRET_KEY=change-me
